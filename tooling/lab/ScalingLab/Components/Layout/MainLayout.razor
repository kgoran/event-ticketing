@inherits LayoutComponentBase

<header class="topbar">
    <div class="topbar-inner">
        <span class="brand">EventTicketing · Scaling Lab</span>
        <span class="topbar-note">Tooling: load on the product through its public API</span>
    </div>
</header>

<main class="page">
    @Body
</main>

<footer class="footer">
    Under Aspire every host runs once; in the lab cluster (<code>dotnet run lab.cs -- up</code>) PublicApi runs as several
    instances, set by hand or by its autoscaler on CPU (ADR-0054). Autoscaling on utilization, and its presets, come in M5.
</footer>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>
