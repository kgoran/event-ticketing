<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Product assemblies and namespaces start with "EventTicketing.", e.g. EventTicketing.Shared.Domain. -->
  <PropertyGroup>
    <AssemblyName>EventTicketing.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>EventTicketing.$(MSBuildProjectName)</RootNamespace>
    <!-- One image per host (ADR-0029): eventticketing/publicapi, eventticketing/workers, … -->
    <ContainerRepository>eventticketing/$(MSBuildProjectName.ToLowerInvariant())</ContainerRepository>
  </PropertyGroup>
</Project>
