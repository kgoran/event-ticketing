  "components": {
    "schemas": {
      "AddMemberRequest": {
        "required": [
          "userId",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "CallerResponse": {
        "required": [
          "userId",
          "roles",
          "organizerIds"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "organizerIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "ChangePricesRequest": {
        "required": [
          "prices"
        ],
        "type": "object",
        "properties": {
          "prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceChange"
            }
          }
        }
      },
      "CreateEvent": {
        "required": [
          "organizerId",
          "venueId",
          "name",
          "startsAt",
          "currency",
          "priceCategories",
          "seating"
        ],
        "type": "object",
        "properties": {
          "organizerId": {
            "type": "string",
            "format": "uuid"
          },
          "venueId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "currency": {
            "type": "string"
          },
          "priceCategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceCategoryInput"
            }
          },
          "seating": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceAssignmentInput"
            }
          }
        }
      },
      "CreateOrganizer": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "organizerId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "DeviceSummary": {
        "required": [
          "deviceId",
          "name",
          "clientId",
          "registeredAt",
          "revokedAt",
          "lastUploadAt",
          "scans"
        ],
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "clientId": {
            "type": "string"
          },
          "registeredAt": {
            "type": "string",
            "format": "date-time"
          },
          "revokedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastUploadAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "scans": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "EventCreated": {
        "required": [
          "eventId"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "EventDetails": {
        "required": [
          "eventId",
          "organizerId",
          "venueId",
          "name",
          "startsAt",
          "currency",
          "status",
          "salesPhase",
          "onSaleAt",
          "publishedAt",
          "priceCategories",
          "seating"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "organizerId": {
            "type": "string",
            "format": "uuid"
          },
          "venueId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
