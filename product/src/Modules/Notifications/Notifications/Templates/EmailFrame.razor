@* The frame every email shares. Email clients ignore stylesheets, so styles are inline. *@
<div style="font-family: Segoe UI, Helvetica, Arial, sans-serif; color: #1c1917; background: #fafaf9; padding: 24px;">
    <div style="max-width: 560px; margin: 0 auto; background: #ffffff; border: 1px solid #e7e5e4; border-radius: 12px; padding: 24px;">
        <p style="margin: 0 0 16px; font-weight: 700; letter-spacing: 0.02em;">EventTicketing</p>
        @ChildContent
    </div>
    <p style="max-width: 560px; margin: 12px auto 0; color: #78716c; font-size: 12px; text-align: center;">
        A teaching project: demo events, no real money. This email went to Mailpit, not to anyone's inbox.
    </p>
</div>

@code {
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;
}
