    {
      "id": 6,
      "type": "timeseries",
      "title": "Hold results",
      "description": "PlaceHold by result: placed, or why not (hold.seats_unavailable: someone was quicker; hold.not_on_sale; hold.active_hold_exists: one hold per fan). An on-sale rush is mostly seats_unavailable, which is the system working.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (eventticketing_outcome, eventticketing_error_code) (rate(eventticketing_commands_handled_total{eventticketing_command=\"PlaceHold\"}[1m]))",
          "legendFormat": "{{eventticketing_outcome}} {{eventticketing_error_code}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 35,
            "showPoints": "never",
            "spanNulls": 30000,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
