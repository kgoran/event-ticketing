    {
      "id": 11,
      "type": "timeseries",
      "title": "Rollbacks and deadlocks",
      "description": "Transactions rolled back per second (many are expected: a hold that lost the race), and deadlocks (should be none).",
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(cnpg_pg_stat_database_xact_rollback{datname=\"eventticketing\"}[1m]))",
          "legendFormat": "rollbacks {{pod}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(cnpg_pg_stat_database_deadlocks{datname=\"eventticketing\"}[1m]))",
          "legendFormat": "deadlocks {{pod}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 30000
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "Share of reads served from PostgreSQL's shared buffers rather than disk, per instance.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(cnpg_pg_stat_database_blks_hit{datname=\"eventticketing\"}[5m])) / clamp_min(sum by (pod) (rate(cnpg_pg_stat_database_blks_hit{datname=\"eventticketing\"}[5m])) + sum by (pod) (rate(cnpg_pg_stat_database_blks_read{datname=\"eventticketing\"}[5m])), 1e-9)",
          "legendFormat": "{{pod}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 30000
          }
        },
        "overrides": []
