      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "EventTicketing",
      "type": "dashboards",
      "tags": [
        "eventticketing"
