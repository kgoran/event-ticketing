        "x": 0,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (cnpg_pgbouncer_pools_cl_active{database=\"eventticketing\"})",
          "legendFormat": "active {{pod}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (cnpg_pgbouncer_pools_cl_waiting{database=\"eventticketing\"})",
          "legendFormat": "waiting {{pod}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 30000
          },
          "min": 0
        },
        "overrides": []
      },
