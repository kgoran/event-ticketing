    {
      "id": 14,
      "type": "timeseries",
      "title": "Thread pool queue",
      "description": "Work items waiting for a thread-pool thread. Above zero for long means the instance is saturated, or something blocks threads (sync over async).",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (dotnet_thread_pool_queue_length_total{job=\"$service\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
