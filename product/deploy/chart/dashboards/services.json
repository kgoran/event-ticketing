    {
      "id": 16,
      "type": "timeseries",
      "title": "Database connections per instance",
      "description": "Npgsql's pool on each instance: connections in use and idle. Every instance's pool counts against the connection budget (docs/lab.md); PgBouncer shares the database's connections between them.",
      "gridPos": {
        "x": 16,
        "y": 30,
        "w": 8,
