        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "GC pause time",
      "description": "Share of time the garbage collector paused the process, per instance. A few percent is normal; much more means it allocates too much.",
      "gridPos": {
        "x": 8,
        "y": 30,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (rate(dotnet_gc_pause_time_seconds_total{job=\"$service\", instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
